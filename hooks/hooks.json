{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/claude_session_start.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/claude_session_start.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/claude_pre_agent.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/claude_pre_agent.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
